{
  "name": "@synergy/server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --project tsconfig.json src/index.ts",
    "build": "tsc && npm run copy-html",
    "copy-html": "mkdir -p dist/html && cp -r src/html/* dist/html/",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "@synergy/shared": "1.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "prisma": "^6.5.0",
    "socket.io": "^4.8.1",
    "ts-node-dev": "^2.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.1"
  }
}
